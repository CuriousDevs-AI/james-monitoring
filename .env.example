# james-monitoring — secrets and runtime settings.
# Copy to `.env` next to your config.yaml (`cp .env.example .env`). It is gitignored; the console writes it with
# mode 0600 when you paste keys or tokens there. Variables already set in the environment win over this file.
# Everything is optional: set only what you use.

# --- Console ---------------------------------------------------------------------------------
# The founder's console key (the `?k=` in the link `jm run` prints). Unset = a new random key on every start.
JM_CONSOLE_KEY=

# --- AI model API keys (only for API providers; CLI subscriptions keep their own login) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Telegram: one bot token per person, TG_TOKEN_<MEMBER ID IN CAPITALS> -----------------------
# TG_TOKEN_JAMES=123456789:AA...
# TG_TOKEN_RIYA=123456789:AA...

# --- Slack (Socket Mode app, see docs/SLACK.md) --------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Public link (Cloudflare Tunnel) — only for your own domain; the quick tunnel needs nothing -----
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...      # a named tunnel's token; also set public.url in config.yaml

# --- Optional overrides for the model CLIs and gh ------------------------------------------------
# JM_CLAUDE_BIN=/usr/local/bin/claude
# JM_CODEX_BIN=/usr/local/bin/codex
# JM_OPENCODE_BIN=/usr/local/bin/opencode
# JM_GH_BIN=/usr/local/bin/gh
# JM_CLOUDFLARED_BIN=/usr/local/bin/cloudflared
# JM_CLAUDE_TIMEOUT=180          # seconds per call (default 180)
# JM_CODEX_TIMEOUT=180
# JM_OPENCODE_TIMEOUT=180
# JM_OPENCODE_AUTH=~/.local/share/opencode/auth.json   # where OpenCode keeps its logins
